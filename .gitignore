# vendor/

# Go workspace file
go.work
go.work.sum

# env files
.env
.env.*

# ==========================================
# Rust
# ==========================================
# Generated by Cargo
# Will contain compiled artifacts, compiled dependencies, and doc
/target/

# Remove this macro if you wish to lock your dependencies for a binary package
# Cargo.lock

# These are paths used by backup tools, tools like cargo-vendor, etc.
# debug/
# vendor/

# Visual Studio Code / LLDB artifacts
.vscode/
*.pdb

